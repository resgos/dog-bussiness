# Скопируй в .env и заполни.

# PostgreSQL (docker-compose поднимает на порту 5433).
DATABASE_URL="postgresql://lapka:lapka@localhost:5433/lapka?schema=public"

# Базовый URL приложения — для ссылок в письмах/уведомлениях и og:url.
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# Web-Push (VAPID). Сгенерируй пару: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@example.com"

# E-mail (SMTP). Оставь SMTP_HOST пустым в dev — письма пойдут в консоль.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Лапка помощи <hello@example.com>"

# Telegram-бот (опционально): токен из @BotFather + id канала/чата района.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHANNEL_ID=""

# Хранилище фото: datauri (в БД, MVP) | local (файлы на диске) | s3/kts (облако, позже).
STORAGE_DRIVER="datauri"
UPLOAD_DIR="./uploads"

# Redis для общего rate-limit (docker-compose сервис redis). Пусто → in-memory.
REDIS_URL=""
