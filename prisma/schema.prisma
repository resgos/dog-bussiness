// Лапка помощи — схема БД (PostgreSQL).
// Postgres поднимается через docker-compose (см. docker-compose.yml).
// JSON-массивы (marks/walkSpots/temperament) хранятся строками для совместимости.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Owner {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  district  String?
  telegram  String?
  createdAt DateTime @default(now())
  pets      Pet[]
}

model Pet {
  id          String   @id @default(cuid())
  name        String
  breed       String?
  sex         String?
  age         String?
  size        String?
  color       String?
  marks       String?  // JSON-массив
  chip        String?
  marksText   String?
  district    String?
  address     String?
  walkSpots   String?  // JSON-массив
  temperament String?  // JSON-массив
  ownerPhone  String?
  extraPhone  String?
  telegram    String?
  showPhone   Boolean  @default(false)
  photo       String?  // data URL (уменьшенный)
  status      String   @default("home") // home | lost | found
  createdAt   DateTime @default(now())
  owner       Owner?   @relation(fields: [ownerId], references: [id])
  ownerId     String?
  user        User?    @relation(fields: [userId], references: [id])
  userId      String?
  healthRecords HealthRecord[]
  photos      PetPhoto[]

  @@index([ownerId])
  @@index([userId])
  @@index([chip])
}

/// Доп. фото питомца (разные ракурсы) — ТЗ: до 10 штук. Главное фото — Pet.photo.
model PetPhoto {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id])
  url       String // data URL (уменьшенный)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([petId])
}

/// Запись в дневнике здоровья питомца (прививки, вес, обработки) — «Лапка+».
model HealthRecord {
  id        String    @id @default(cuid())
  petId     String
  pet       Pet       @relation(fields: [petId], references: [id])
  type      String // vaccine | deworming | weight | treatment | other
  title     String
  date      DateTime
  nextDue   DateTime?
  value     String?
  note      String?
  createdAt DateTime  @default(now())

  @@index([petId])
}

model FoundEvent {
  id        String   @id @default(cuid())
  petName   String?
  district  String?
  createdAt DateTime @default(now())
}

model LostReport {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  petId     String?
  petName   String
  breed     String?
  photo     String?
  district  String?
  lat       Float?
  lng       Float?
  lostAt    DateTime?
  comment   String?
  radiusKm  Int        @default(3)
  reward    Int? // вознаграждение нашедшему, ₽
  checklist String? // JSON-массив выполненных шагов плейбука поиска
  status    String     @default("active") // active | found | home
  createdAt DateTime   @default(now())
  sightings Sighting[]
  subscribers ReportSubscription[]

  @@index([userId])
  @@index([status])
}

/// Подписка пользователя на объявление о пропаже — ТЗ 4.5 «подписаться и получать
/// обновления». Уведомляем подписчиков о новых наблюдениях и смене статуса.
model ReportSubscription {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  reportId  String
  report    LostReport @relation(fields: [reportId], references: [id])
  createdAt DateTime   @default(now())

  @@unique([userId, reportId])
  @@index([reportId])
}

/// Находка: нашли чужую/бездомную собаку (ищем владельца).
model FoundReport {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  finderName      String?
  contactPhone    String?
  contactTelegram String?
  photo           String?
  breed           String?
  color           String?
  size            String? // small | medium | large
  district        String?
  lat             Float?
  lng             Float?
  comment         String?
  status          String   @default("open") // open | reunited
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([district])
  @@index([status])
}

model Sighting {
  id        String      @id @default(cuid())
  reportId  String?
  report    LostReport? @relation(fields: [reportId], references: [id])
  lat       Float?
  lng       Float?
  comment   String?
  photo     String?
  createdAt DateTime    @default(now())

  @@index([reportId])
}

// ——— Авторизация ———
model User {
  id           String     @id @default(cuid())
  name         String
  phone        String?    @unique
  email        String?    @unique
  passwordHash String?
  district     String?
  telegram     String?
  role         String     @default("user") // user | volunteer | ambassador | partner
  helpedCount  Int        @default(0)
  createdAt    DateTime   @default(now())
  sessions     Session[]
  pets         Pet[]
  posts        Post[]
  comments     Comment[]
  postLikes     PostLike[]
  orders        Order[]
  notifications Notification[]
  lostReports   LostReport[]
  foundReports  FoundReport[]
  pushSubs        PushSubscription[]
  resetTokens     PasswordResetToken[]
  verifyTokens    EmailVerificationToken[]
  reports         Report[]
  emailVerifiedAt DateTime?
  referralCode    String?  @unique
  referredById    String?
  referredBy      User?    @relation("Referrals", fields: [referredById], references: [id])
  referrals       User[]   @relation("Referrals")
  walkCheckins    WalkCheckin[]
  reportSubs      ReportSubscription[]
}

/// Токен подтверждения e-mail (мягкая верификация, не блокирует вход).
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Жалоба на контент (модерация).
model Report {
  id         String   @id @default(cuid())
  targetType String // post | found | lost | comment
  targetId   String
  reason     String // spam | abuse | fake | other
  comment    String?
  reporterId String?
  reporter   User?    @relation(fields: [reporterId], references: [id])
  status     String   @default("open") // open | resolved | dismissed
  createdAt  DateTime @default(now())

  @@index([status])
}

/// Одноразовый токен сброса пароля (с TTL).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// ——— Комьюнити ———
model Post {
  id        String     @id @default(cuid())
  authorId  String?
  author    User?      @relation(fields: [authorId], references: [id])
  district  String?
  type      String     @default("обсуждение") // пропажа|находка|наблюдение|совет|событие|обсуждение
  text      String
  photo     String?
  createdAt DateTime   @default(now())
  comments  Comment[]
  likes     PostLike[]

  @@index([authorId])
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([postId])
  @@index([authorId])
}

model PostLike {
  id     String @id @default(cuid())
  postId String
  post   Post   @relation(fields: [postId], references: [id])
  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
  @@index([userId])
}

// ——— Магазин ———
model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  category    String // addressniki | bracelets | merch | combo
  priceRub    Int
  description String?
  image       String?
  createdAt   DateTime    @default(now())
  orderItems  OrderItem[]
}

model Order {
  id        String      @id @default(cuid())
  userId    String?
  user      User?       @relation(fields: [userId], references: [id])
  name      String?
  phone     String?
  address   String?
  status    String      @default("new") // new | processing | done
  totalRub  Int         @default(0)
  createdAt DateTime    @default(now())
  items     OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  qty       Int     @default(1)
  priceRub  Int

  @@index([orderId])
  @@index([productId])
}

/// Подписка браузера/устройства на web-push.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Чек-ин «гуляю сейчас» — живые глаза района (актуальность ~2 часа на выборке).
model WalkCheckin {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  lat       Float?
  lng       Float?
  district  String?
  note      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

/// Собака на пристройство (приюты / в добрые руки).
model AdoptionListing {
  id              String   @id @default(cuid())
  name            String
  breed           String?
  age             String?
  size            String?
  color           String?
  photo           String?
  district        String?
  story           String?
  contactName     String?
  contactPhone    String?
  contactTelegram String?
  status          String   @default("open") // open | adopted
  createdAt       DateTime @default(now())

  @@index([status])
}

/// Партнёр-сервис рядом (ветклиника, груминг, гостиница, кинолог).
model Partner {
  id          String   @id @default(cuid())
  name        String
  type        String // vet | groomer | hotel | trainer | shop
  district    String?
  address     String?
  phone       String?
  url         String?
  description String?
  createdAt   DateTime @default(now())

  @@index([type])
}

// ——— Уведомления (in-app) ———
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   @default("info") // sos | found | system | info
  title     String
  body      String?
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}
